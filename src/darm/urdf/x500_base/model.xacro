    <limit lower="-1e+16" upper="1e+16" effort="10.0" velocity="100.0"/>
  </joint>


<!-- ARM  -->

 <link
    name="arm_link">
    <inertial>
      <origin
        xyz="-0.000914795426225395 -0.00555454895196864 -0.110946439422579"
        rpy="0 0 0" />
      <mass
        value="0.0657523999494041" />
      <inertia
        ixx="0.000309254167993113"
        ixy="-3.1320330373311E-07"
        ixz="-6.25537879411743E-06"
        iyy="0.000315762751117713"
        iyz="-1.52579272127627E-05"
        izz="1.17649990461412E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="${mesh_prefix}/x500_base/meshes/arm_link.stl" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.698039215686274 0.698039215686274 0.698039215686274 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="${mesh_prefix}/x500_base/meshes/arm_link.stl" />
      </geometry>
    </collision>
  </link>
  <joint
    name="arm_rev"
    type="revolute">
    <origin
      xyz="0.069625 0 -0.01711"
      rpy="1.5958 0 -1.5708" />
    <parent
      link="base_link" />
    <child
      link="arm_link" />
    <axis
      xyz="1 0 0" />
    <limit
      lower="-1.57"
      upper="1.57"
      effort="1"
      velocity="5" />
  </joint>
