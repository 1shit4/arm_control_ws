<?xml version='1.0' encoding='UTF-8'?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="x500_base">
  <xacro:include filename="macros.xacro"/>
  <xacro:include filename="materials.xacro"/>
  <xacro:include filename="control.xacro"/>
  <xacro:property name="mesh_prefix" value="file://$(find darm)/models"/>
  <link name="base_link">
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.02166666666666667" ixy="0.0" ixz="0.0" iyy="0.02166666666666667" iyz="0.0" izz="0.04000000000000001"/>
    </inertial>
    <visual name="base_link_visual">
      <origin xyz="0.0 0.0 0.025" rpy="0.0 0.0 3.141592654"/>
      <geometry>
        <mesh filename="${mesh_prefix}/x500_base/meshes/NXP-HGD-CF.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <visual name="5010_motor_base_0">
      <origin xyz="0.174 0.174 0.032" rpy="0.0 0.0 -0.45"/>
      <geometry>
        <mesh filename="${mesh_prefix}/x500_base/meshes/5010Base.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <visual name="5010_motor_base_1">
      <origin xyz="-0.174 0.174 0.032" rpy="0.0 0.0 -0.45"/>
      <geometry>
        <mesh filename="${mesh_prefix}/x500_base/meshes/5010Base.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <visual name="5010_motor_base_2">
      <origin xyz="0.174 -0.174 0.032" rpy="0.0 0.0 -0.45"/>
      <geometry>
        <mesh filename="${mesh_prefix}/x500_base/meshes/5010Base.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <visual name="5010_motor_base_3">
      <origin xyz="-0.174 -0.174 0.032" rpy="0.0 0.0 -0.45"/>
      <geometry>
        <mesh filename="${mesh_prefix}/x500_base/meshes/5010Base.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision name="base_link_collision_0">
      <origin xyz="0.0 0.0 0.007" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="0.35355339059327373 0.35355339059327373 0.05"/>
      </geometry>
    </collision>
    <collision name="base_link_collision_1">
      <origin xyz="0.0 -0.098 -0.123" rpy="-0.35 0.0 0.0"/>
      <geometry>
        <box size="0.015 0.015 0.21"/>
      </geometry>
    </collision>
    <collision name="base_link_collision_2">
      <origin xyz="0.0 0.098 -0.123" rpy="0.35 0.0 0.0"/>
      <geometry>
        <box size="0.015 0.015 0.21"/>
      </geometry>
    </collision>
    <collision name="base_link_collision_3">
      <origin xyz="0.0 -0.132 -0.2195" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="0.25 0.015 0.015"/>
      </geometry>
    </collision>
    <collision name="base_link_collision_4">
      <origin xyz="0.0 0.132 -0.2195" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="0.25 0.015 0.015"/>
      </geometry>
    </collision>
  </link>

<!-- rotor links -->
  <link name="rotor_0">
    <inertial>
      <mass value="0.016076923076923075"/>
      <inertia ixx="3.8464910483993325e-07" ixy="0.0" ixz="0.0" iyy="2.6115851691700804e-05" iyz="0.0" izz="2.649858234714004e-05"/>
    </inertial>
    <visual name="rotor_0_visual">
      <origin xyz="-0.022 -0.14638461538461536 -0.016" rpy="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="${mesh_prefix}/x500_base/meshes/1345_prop_ccw.stl" scale="0.8461538461538461 0.8461538461538461 0.8461538461538461"/>
      </geometry>
    </visual>
    <visual name="rotor_0_visual_motor_bell">
      <origin xyz="0.0 0.0 -0.032" rpy="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="${mesh_prefix}/x500_base/meshes/5010Bell.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision name="rotor_0_collision">
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="0.2792307692307692 0.016923076923076923 0.0008461538461538462"/>
      </geometry>
    </collision>
  </link>
  <link name="rotor_1">
    <inertial>
      <mass value="0.016076923076923075"/>
      <inertia ixx="3.8464910483993325e-07" ixy="0.0" ixz="0.0" iyy="2.6115851691700804e-05" iyz="0.0" izz="2.649858234714004e-05"/>
    </inertial>
    <visual name="rotor_1_visual">
      <origin xyz="-0.022 -0.14638461538461536 -0.016" rpy="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="${mesh_prefix}/x500_base/meshes/1345_prop_ccw.stl" scale="0.8461538461538461 0.8461538461538461 0.8461538461538461"/>
      </geometry>
    </visual>
    <visual name="rotor_1_visual_motor_top">
      <origin xyz="0.0 0.0 -0.032" rpy="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="${mesh_prefix}/x500_base/meshes/5010Bell.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision name="rotor_1_collision">
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="0.2792307692307692 0.016923076923076923 0.0008461538461538462"/>
      </geometry>
    </collision>
  </link>
  <link name="rotor_2">
    <inertial>
      <mass value="0.016076923076923075"/>
      <inertia ixx="3.8464910483993325e-07" ixy="0.0" ixz="0.0" iyy="2.6115851691700804e-05" iyz="0.0" izz="2.649858234714004e-05"/>
    </inertial>
    <visual name="rotor_2_visual">
      <origin xyz="-0.022 -0.14638461538461536 -0.016" rpy="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="${mesh_prefix}/x500_base/meshes/1345_prop_cw.stl" scale="0.8461538461538461 0.8461538461538461 0.8461538461538461"/>
      </geometry>
    </visual>
    <visual name="rotor_2_visual_motor_top">
      <origin xyz="0.0 0.0 -0.032" rpy="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="${mesh_prefix}/x500_base/meshes/5010Bell.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision name="rotor_2_collision">
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="0.2792307692307692 0.016923076923076923 0.0008461538461538462"/>
      </geometry>
    </collision>
  </link>
  <link name="rotor_3">
    <inertial>
      <mass value="0.016076923076923075"/>
      <inertia ixx="3.8464910483993325e-07" ixy="0.0" ixz="0.0" iyy="2.6115851691700804e-05" iyz="0.0" izz="2.649858234714004e-05"/>
    </inertial>
    <visual name="rotor_3_visual">
      <origin xyz="-0.022 -0.14638461538461536 -0.016" rpy="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="${mesh_prefix}/x500_base/meshes/1345_prop_cw.stl" scale="0.8461538461538461 0.8461538461538461 0.8461538461538461"/>
      </geometry>
    </visual>
    <visual name="rotor_3_visual_motor_top">
      <origin xyz="0.0 0.0 -0.032" rpy="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="${mesh_prefix}/x500_base/meshes/5010Bell.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision name="rotor_3_collision">
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="0.2792307692307692 0.016923076923076923 0.0008461538461538462"/>
      </geometry>
    </collision>
  </link>

<!-- Rotor joints -->
  <joint name="rotor_0_joint" type="revolute">
    <parent link="base_link"/>
    <child link="rotor_0"/>
    <origin xyz="0.174 0.174 0.06" rpy="0.0 0.0 0.0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1e+16" upper="1e+16" effort="10.0" velocity="100.0"/>
  </joint>
  <joint name="rotor_1_joint" type="revolute">
    <parent link="base_link"/>
    <child link="rotor_1"/>
    <origin xyz="-0.174 0.174 0.06" rpy="0.0 0.0 0.0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1e+16" upper="1e+16" effort="10.0" velocity="100.0"/>
  </joint>
  <joint name="rotor_2_joint" type="revolute">
    <parent link="base_link"/>
    <child link="rotor_2"/>
    <origin xyz="0.174 -0.174 0.06" rpy="0.0 0.0 0.0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1e+16" upper="1e+16" effort="10.0" velocity="100.0"/>
  </joint>
  <joint name="rotor_3_joint" type="revolute">
    <parent link="base_link"/>
    <child link="rotor_3"/>
    <origin xyz="-0.174 -0.174 0.06" rpy="0.0 0.0 0.0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1e+16" upper="1e+16" effort="10.0" velocity="100.0"/>
  </joint>

<!-- ARM  -->
  <!-- Arm Base Link -->
  <link name="arm_base_link">
    <inertial>
      <origin xyz="-0.019361 0.032893 -9.1547E-05" rpy="0 0 0"/>
      <mass value="0.052444"/>
      <inertia ixx="1.5785E-05" ixy="-2.5913E-07" ixz="-6.0461E-09" iyy="9.052E-06" iyz="-6.1966E-07" izz="1.5108E-05"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder length="0.04" radius="0.04"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.04" radius="0.04"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
  </link>

  <!-- Mount Joint (Fixed to Base Link) -->
  <joint name="mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_base_link"/>
    <origin xyz="0 0 -0.12" rpy="0 0 0"/>
  </joint>

  <!-- Link 1 -->
  <link name="arm_link_1">
    <inertial>
      <origin xyz="-0.023624 -1.3508E-07 -0.068962" rpy="0 0 0"/>
      <mass value="0.037731"/>
      <inertia ixx="1.7815E-05" ixy="-3.5965E-12" ixz="-1.8434E-07" iyy="2.7209E-05" iyz="-1.2773E-10" izz="1.2586E-05"/>
    </inertial>
    <visual>
      <!-- Offset -0.09 to center the 0.18 cylinder -->
      <origin xyz="0 0 -0.09" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.18" radius="0.02"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.09" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.18" radius="0.02"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 1 -->
  <joint name="joint_1" type="revolute">
    <axis xyz="-1 0 0"/>
    <limit effort="100.0" lower="-1.57" upper="1.57" velocity="100.0"/>
    <parent link="arm_base_link"/>
    <child link="arm_link_1"/>
    <origin xyz="0 0 0.0012" rpy="0 0 0"/>
  </joint>

  <!-- Link 2 -->
  <link name="arm_link_2">
    <inertial>
      <origin xyz="-0.023061 0.00033471 -0.097629" rpy="0 0 0"/>
      <mass value="0.21897"/>
      <inertia ixx="0.00011176" ixy="-2.2612E-09" ixz="7.538E-07" iyy="0.00012426" iyz="1.022E-06" izz="5.0106E-05"/>
    </inertial>
    <visual>
      <!-- Offset -0.1 to center the 0.20 cylinder -->
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.20" radius="0.02"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.20" radius="0.02"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 2 -->
  <joint name="joint_2" type="revolute">
    <axis xyz="-1 0 0"/>
    <limit effort="100.0" lower="-2.094" upper="2.094" velocity="100.0"/>
    <parent link="arm_link_1"/>
    <child link="arm_link_2"/>
    <origin xyz="0 0 -0.1795" rpy="0 0 0"/>
  </joint>

<!-- control tags -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    
    <joint name="joint_1">
      <command_interface name="position">
        <param name="min">-1.57</param>
        <param name="max">1.57</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <initial_position>-1.57</initial_position>
    </joint>

    <joint name="joint_2">
      <command_interface name="position">
        <param name="min">-2.094</param>
        <param name="max">2.094</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

</robot>
